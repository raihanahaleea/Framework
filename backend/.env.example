# Server
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=3600s

# Geofencing (Unand Asrama)
ASRAMA_LAT=-0.9169337875669057
ASRAMA_LONG=100.45326630992055
ASRAMA_MAX_RADIUS_METERS=200

# Multer upload directory
UPLOAD_DIR=uploads/presensi

